      orcid: "https://orcid.org/0000-0002-5454-6821"
  journal: "Circuits, Systems, and Signal Processing"
  volume: 41
  start: 1683
  end: 1703
  year: 2022
  doi: "10.1007/s00034-021-01855-x"
  publisher:
    name: Springer
